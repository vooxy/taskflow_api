# Скопируйте этот файл в .env и задайте свои значения.
# Без .env docker compose использует значения по умолчанию (taskflow / taskflow).
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow

# Нужен только для запуска API или Alembic без Docker (локально, БД на порту хоста).
# Внутри Docker Compose DATABASE_URL собирается автоматически и указывает на хост "db".
DATABASE_URL=postgresql+psycopg2://taskflow:change-me@localhost:5432/taskflow
